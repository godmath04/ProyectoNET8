@using BlogCore.Models.ViewModels
@using BlogCore.Utilidades
@model IEnumerable<KhUserViewModel>
@{
    ViewData["Title"] = "Lista de Usuarios";
}

<br />
<br />
<div class="border">
    <div class="row">
        <div class="col-6">
            <h2 class="text-center">Lista de Usuarios</h2>
        </div>
        <div class="col-6">
            <a asp-area="Admin" asp-controller="Register" asp-action="Index" class="btn btn-info">
                <i class="fas fa-plus"></i> &nbsp; Registra un nuevo usuario
            </a>


        </div>
    </div>

    @if (Model.Count() > 0)
    {
        <table class="table table-striped table-bordered" style="width: 100%">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Id)</th>
                    <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                    <th>@Html.DisplayNameFor(m => m.Email)</th>                    
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre @item.Apellido</td>
                        <td>@item.Email</td>
                        <td>
                            @if (item.Enabled)
                            {
                                <form method="post" asp-action="Bloquear" asp-route-id="@item.Id" style="display:inline">
                                    <button class="btn btn-danger" title="Bloquear usuario">
                                        <i class="fas fa-lock"></i> Bloquear
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-action="Desbloquear" asp-route-id="@item.Id" style="display:inline">
                                    <button class="btn btn-success" title="Desbloquear usuario">
                                        <i class="fas fa-lock-open"></i> Desbloquear
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>

        </table>

        
    }
</div>