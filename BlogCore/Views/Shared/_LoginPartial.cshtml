@using Microsoft.AspNetCore.Identity

<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="nav-link text-white">Hola, @User.Identity?.Name!</span>
        </li>
        <li class="nav-item">
            <form class="form-inline" href="/Auth/SignOut asp-action="SignOut" asp-area="" method="post">
                <button type="submit" class="nav-link btn btn-link">Cerrar Sesión</button>
            </form>


        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white" href="/Auth/SignIn">Acceso</a>
        </li>
    }
</ul>


