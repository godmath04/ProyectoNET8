@using Microsoft.AspNetCore.Identity

<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="nav-link text-white">Hola, @User.Identity?.Name!</span>
        </li>
        <li class="nav-item">
            <form method="post" action="/Auth/SignOut" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-light ms-2">Cerrar Sesión</button>
            </form>

        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white" href="/Auth/SignIn">Acceso</a>
        </li>
    }
</ul>


